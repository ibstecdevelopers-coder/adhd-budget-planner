{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/app/:path*", "destination": "/", "permanent": false },
    { "source": "/start/:path*", "destination": "/", "permanent": false },
    { "source": "/download/:path*", "destination": "/", "permanent": false },
    { "source": "/p/", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/demo/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/p/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/p/:slug/download/(.*)", "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"world-trade-net-budget-planner.html\"" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
